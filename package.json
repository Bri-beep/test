{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env.local src/server/index.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local dist/server/index.js",
    "lint": "eslint src scripts tests e2e playwright.config.ts --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run template:check && npm run template:release:check && npm run app:spec:check && npm run data:access:check && npm run data:prepare:check && npm run lint && npm run typecheck && npm test && npm run build",
    "init-app": "node scripts/init-app.mjs",
    "app:guide": "node scripts/app-guide.mjs",
    "app:orchestrate": "node scripts/app-orchestrate.mjs",
    "app:capabilities": "node scripts/app-capabilities.mjs",
    "app:skills": "node scripts/app-skills.mjs",
    "app:spec:check": "node scripts/app-guide.mjs --check",
    "feature:new": "node scripts/new-feature.mjs",
    "data:init": "node scripts/init-data.mjs",
    "data:access:render": "node scripts/render-data-access.mjs",
    "data:access:check": "node scripts/render-data-access.mjs --check --allow-placeholder",
    "data:prepare:render": "node scripts/render-data-preparation.mjs",
    "data:prepare:check": "node scripts/render-data-preparation.mjs --check --allow-placeholder",
    "data:prepare": "node scripts/run-data-preparation.mjs",
    "data:replay": "node scripts/run-data-preparation.mjs --run-only",
    "databricks:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-databricks.ts",
    "test:databricks": "node --env-file-if-exists=.env.local --import tsx scripts/test-databricks.ts",
    "bundle:validate": "node scripts/deploy.mjs --validate-only",
    "bundle:compatibility": "node --import tsx scripts/validate-bundle-cli.ts",
    "template:journey": "node --import tsx scripts/validate-template-journey.ts",
    "template:status": "node scripts/template-status.mjs",
    "template:check": "node scripts/template-status.mjs --check",
    "template:diff": "node scripts/template-status.mjs --diff",
    "template:release:check": "node scripts/check-template-release.mjs",
    "bundle:summary": "databricks bundle summary",
    "app:provision": "node scripts/deploy.mjs --provision-only",
    "app:smoke": "node scripts/smoke-deployed-app.mjs",
    "app:doctor": "node scripts/app-doctor.mjs",
    "preview:real": "node scripts/preview-real.mjs",
    "deploy": "node scripts/deploy.mjs",
    "app:local": "databricks apps run-local --entry-point app.yaml",
    "user-state:init": "node scripts/init-user-state.mjs",
    "template:migration": "node --import tsx scripts/validate-v2-migration.ts",
    "upstream:check": "node scripts/check-upstream.mjs",
    "app": "node scripts/app.mjs"
  },
  "dependencies": {
    "@databricks/appkit": "0.76.1",
    "@databricks/appkit-ui": "0.76.1",
    "@databricks/sql": "2.0.0",
    "@fontsource-variable/outfit": "5.3.0",
    "d3-geo": "3.1.1",
    "express": "4.22.2",
    "framer-motion": "13.1.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.1",
    "@types/express": "4.17.25",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.5.4",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "17.4.0",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "npm:rolldown-vite@7.1.14",
    "yaml": "2.9.0"
  }
}
